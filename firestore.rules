rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
    * AUTHENTICATION HELPERS
    */
    function isAuthorizedManager() {
      return request.auth != null && (
        request.auth.token.email == 'nicholas.grace@rredco.com' ||
        request.auth.token.email == 'accounting@rredco.com' ||
        request.auth.token.email.matches('.*@rredco[.]com$')
      );
    }
    /**
    * WORKBOOK & BOARD REPORT HOOK
    * Corrected syntax for collection with spaces: "promo tracker"
    */
    match /{colName}/{document} {
      allow read: if colName == "promo tracker" && isAuthorizedManager();
      // Restrict modification to Nicholas Grace
      allow write: if colName == "promo tracker" && 
      request.auth != null && 
      request.auth.token.email == 'nicholas.grace@rredco.com';
    }
    /**
    * CORE COLLECTIONS
    */
    match /promoCredits/{creditId} {
      allow read, write: if isAuthorizedManager();
    }
    match /brands/{brandId} {
      allow read, write: if isAuthorizedManager();
    }
    match /treesSales/{saleId} {
      allow read, write: if isAuthorizedManager();
    }
    match /promoRecovered/{recoveryId} {
      allow read, write: if isAuthorizedManager();
    }
    /**
    * SYSTEM AUDIT & HISTORY
    */
    match /systemLogs/{logId} {
      allow create: if isAuthorizedManager();
      allow read, update, delete: if request.auth != null && 
      request.auth.token.email == 'nicholas.grace@rredco.com';
    }
    match /emailHistories/{historyId} {
      allow read, write: if isAuthorizedManager();
    }
    /**
    * GLOBAL SECURITY CATCH-ALL
    */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}